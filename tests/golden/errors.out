dtcalc> now +
error: expected an expression but the line ended
  now +
       ^
dtcalc> (now + 1h
error: missing a closing parenthesis for this one
  (now + 1h
  ^
dtcalc> now + 1h)
error: unexpected ')' after a complete expression
  now + 1h)
          ^
dtcalc> now + now
error: cannot add two points in time; subtract them to get the span between
  now + now
  ^^^^^^^^^
dtcalc> 5h in Tokyo
error: can only convert a date or an instant, not a duration
  5h in Tokyo
  ^^
dtcalc> -now
error: cannot negate an instant
  -now
  ^^^^
dtcalc> now * 2
error: cannot multiply an instant by a number
  now * 2
  ^^^^^^^
dtcalc> 1mo / 4
error: 1 month does not divide evenly by 4; calendar units have no fixed length, so there is no exact answer
  1mo / 4
  ^^^^^^^
dtcalc> 1d % 5h
error: can only take the modulo of durations in the same single ladder; 1d and 5h are not
  1d % 5h
  ^^^^^^^
dtcalc> 1h / 0
error: cannot divide a duration by zero
  1h / 0
  ^^^^^^
dtcalc> now in Atlantis
error: unknown timezone 'Atlantis'
  now in Atlantis
  ^^^^^^^^^^^^^^^
dtcalc> now < 1h
error: cannot compare an instant with a duration
  now < 1h
  ^^^^^^^^
dtcalc> nope + 1h
error: undefined variable 'nope'
  nope + 1h
  ^^^^
dtcalc> h = 3h
error: 'h' is a unit, not a name; units need a number in front of them
  h = 3h
  ^
dtcalc> min = 3h
error: 'min' is a builtin function, so it cannot be a variable name
  min = 3h
  ^^^^^^^^
dtcalc> now = 3h
error: 'now' is a keyword, so it cannot be a variable name
  now = 3h
  ^^^
dtcalc> a < b < c
error: comparisons do not chain; compare two things at a time
  a < b < c
        ^
dtcalc> 12:15s
error: a colon literal's leading unit must be 'h' or 'm', not 's'
  12:15s
  ^^^^^^
dtcalc> 1:2:3:4
error: too many fields in '1:2:3:4': a colon literal has at most three
  1:2:3:4
  ^^^^^^^
dtcalc> 32nd
error: 32 is not a day of the month
  32nd
  ^^^^
dtcalc> 5hfoo
error: '5hfoo' is not a valid literal
  5hfoo
  ^^^^^
dtcalc> now + 7h $
error: unexpected character '$'
  now + 7h $
           ^
dtcalc> nope(now)
error: unknown function 'nope'; the ones there are: ceil, diff, epoch, epochms, max, min, round, trunc, unix
  nope(now)
  ^^^^^^^^^
dtcalc> diff(now)
error: diff takes 2 arguments but was given 1
  diff(now)
  ^^^^^^^^^
dtcalc> trunc(now, 1bd)
error: trunc cannot use 1bd as a granularity: a business day has no position within a month or a year to bucket by
  trunc(now, 1bd)
  ^^^^^^^^^^^^^^^
dtcalc> trunc(today, 1h)
error: trunc cannot use 1h as a granularity for a date: a date has no time of day to round
  trunc(today, 1h)
  ^^^^^^^^^^^^^^^^
dtcalc> trunc(today, 1mo1d)
error: trunc needs a granularity in one ladder; 1mo1d mixes months with days, which have no fixed ratio
  trunc(today, 1mo1d)
  ^^^^^^^^^^^^^^^^^^^
dtcalc> diff(today, now)
error: diff needs both arguments to be the same kind; mixing a date with an instant leaves it ambiguous which calendar to decompose against
  diff(today, now)
  ^^^^^^^^^^^^^^^^
dtcalc> unix(3h)
error: unix needs a date or an instant, not a duration
  unix(3h)
  ^^^^^^^^
dtcalc> today + tomorrow
error: cannot add two points in time; subtract them to get the span between
  today + tomorrow
  ^^^^^^^^^^^^^^^^
dtcalc> -today
error: cannot negate a date
  -today
  ^^^^^^
dtcalc> today * 2
error: cannot multiply a date by a number
  today * 2
  ^^^^^^^^^
dtcalc> 2026-12-24 in Atlantis
error: unknown timezone 'Atlantis'
  2026-12-24 in Atlantis
  ^^^^^^^^^^^^^^^^^^^^^^
dtcalc> :nope
error: unknown command ':nope'; try :help
