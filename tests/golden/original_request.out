dtcalc> # Every example from the original feature request.
dtcalc> now + 7h
2026-05-23T19:15:13-04:00  America/New_York
dtcalc> 2026-05-23T12:15:13 - 12:15
2026-05-23T00:00:13-04:00  America/New_York
dtcalc> 2026-05-23T12:15:13 + 3w2h5m
2026-06-13T14:20:13-04:00  America/New_York
dtcalc> 12:13 @ SanFrancisco
2026-05-23T15:13:00-04:00  America/New_York
dtcalc> foo = now
2026-05-23T12:15:13-04:00  America/New_York
dtcalc> bar = foo + 5h
2026-05-23T17:15:13-04:00  America/New_York
dtcalc> bar
2026-05-23T17:15:13-04:00  America/New_York
dtcalc> foo - 5h
2026-05-23T07:15:13-04:00  America/New_York
dtcalc> 3h * 5
15h
dtcalc> # Days are calendar units, so this is 24h rather than 1d.
dtcalc> 8h * 3
24h
